# ==============================================================================
#  🌱 AGROCHAIN CORE ENVIRONMENT CONFIGURATION - BLUEPRINT TEMPLATE
# ==============================================================================

# 💡 Copy this file and rename it to '.env' inside the same directory.

# 🪐 APPLICATION BASE SETUP
PORT=3001
NODE_ENV=development

# 🐘 POSTGRESQL DATABASE CORE ENGINE
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_local_db_user_here
DB_PASS=your_local_db_password_here
DB_NAME=your_local_db_name_here

# 🛑 REDIS CACHE & BULLMQ QUEUE SYSTEM
REDIS_HOST=localhost
REDIS_PORT=6379

# 🔐 PASSPORT JWT SECURITY RAILS
JWT_SECRET=your_super_strong_jwt_secret_key_goes_here
JWT_EXPIRES_IN=1d

# 💳 THIRD-PARTY INTEGRATIONS (FUTURE PHASES)
PAYMENT_SECRET_KEY=your_payment_gateway_secret
PLATFORM_COMMISSION_RATE=0.05
AGENT_COMMISSION_RATE=0.10

# ☁️ AWS S3 & REKOGNITION CREDENTIALS (NID PIPELINE)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your_agrochain_bucket_name